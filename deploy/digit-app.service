[Unit]
Description=Demo nhan dien chu so viet tay (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=__NGUOI_DUNG__
WorkingDirectory=__THU_MUC__
ExecStart=__THU_MUC__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
